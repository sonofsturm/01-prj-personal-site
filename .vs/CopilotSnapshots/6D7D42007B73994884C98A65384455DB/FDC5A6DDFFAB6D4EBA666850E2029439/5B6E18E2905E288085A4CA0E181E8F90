/* Basic colors and sizes are kept here so they are easy to change later. */
:root {
	--ink: #17252d;
	--muted: #607078;
	--paper: #f7f5f0;
	--white: #ffffff;
	--accent: #e36b4d;
	--accent-dark: #b94c32;
	--line: #dce3df;
}

/* This makes sizing more predictable on every screen. */
* {
	box-sizing: border-box;
}

html {
	scroll-behavior: smooth;
}

body {
	margin: 0;
	color: var(--ink);
	background: var(--paper);
	font-family: Georgia, "Times New Roman", serif;
	line-height: 1.6;
}

.container {
	width: 88%;
	max-width: 1100px;
	margin: 0 auto;
}

.site-header {
	background: var(--paper);
	border-bottom: 1px solid var(--line);
}

.navigation,
.footer-content,
.hero-content,
.split-section {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.navigation {
	min-height: 76px;
}

.logo {
	color: var(--ink);
	font-size: 1.2rem;
	font-weight: bold;
	text-decoration: none;
}

nav a {
  display: inline-flex;
  align-items: center;
  gap: 5px;
	margin-left: 24px;
	color: var(--muted);
	font-family: Arial, sans-serif;
	font-size: 0.85rem;
	text-decoration: none;
}

nav a:hover,
.logo:hover,
.site-footer a:hover {
	color: var(--accent-dark);
}

.hero {
	padding: 90px 0;
	background: var(--white) url("img/hero-bg.jpg") center / cover;
	background-blend-mode: soft-light;
}

.hero-content {
	gap: 60px;
}

.hero-text {
	max-width: 620px;
}

.eyebrow {
	margin: 0 0 10px;
	color: var(--accent-dark);
	font-family: Arial, sans-serif;
	font-size: 0.75rem;
	font-weight: bold;
	letter-spacing: 1.5px;
	text-transform: uppercase;
}

h1,
h2,
h3,
p {
	margin-top: 0;
}

h1 {
	max-width: 650px;
	margin-bottom: 20px;
	font-size: 4.5rem;
	line-height: 1.05;
}

h2 {
	margin-bottom: 18px;
	font-size: 2.6rem;
	line-height: 1.1;
}

h3 {
	margin-bottom: 8px;
	font-size: 1.5rem;
}

.intro,
.section-intro {
	max-width: 650px;
	color: var(--muted);
	font-size: 1.1rem;
}

.button {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	margin-top: 15px;
	padding: 12px 20px;
	color: var(--white);
	background: var(--accent);
	font-family: Arial, sans-serif;
	font-size: 0.9rem;
	font-weight: bold;
	text-decoration: none;
}

/* This class uses the Material Symbols font loaded in the HTML head. */
.material-symbols-outlined {
	font-family: "Material Symbols Outlined";
	font-size: 1.1rem;
	font-weight: normal;
	line-height: 1;
}

.button:hover {
	background: var(--accent-dark);
}

/* This makes links easy to see when using the keyboard. */
a:focus-visible {
	outline: 3px solid var(--accent);
	outline-offset: 4px;
}

.profile-frame {
	width: 230px;
	height: 230px;
	flex-shrink: 0;
	overflow: hidden;
	border: 10px solid var(--white);
	border-radius: 50%;
	box-shadow: 0 15px 35px rgba(23, 37, 45, 0.15);
}

.profile-image {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	object-position: center 70%;
	transform: scale(1.35);
}

.section {
	padding: 90px 0;
}

.section-light {
	background: #e8efeb;
}

.card-row {
	display: flex;
	flex-wrap: wrap;
	gap: 20px;
	margin-top: 35px;
}

.info-card {
	flex: 1;
	min-height: 190px;
	padding: 26px;
	background: var(--white);
	border-top: 3px solid var(--accent);
}

/* These colors are inspired by the Arabic and Spanish cards' cultures. */
.arabic-card {
	color: var(--ink);
	background: #8bc9a5;
	border-top-color: #22613d;
}

.arabic-card p,
.arabic-card .card-number {
	color: #19452e;
}

.spanish-card {
	background: #f3c847;
	border-top-color: #b3262d;
}

.spanish-card .card-number {
	color: #a51f28;
}

.info-card p,
.hobbies-list p {
	margin-bottom: 0;
	color: var(--muted);
}

/* Each technology has its own simple accent color. */
.html-card {
	background: #f8ddd7;
	border-top-color: #d6533f;
}

.css-card {
	background: #dcecf5;
	border-top-color: #287da8;
}

.javascript-card {
	background: #f8edb8;
	border-top-color: #b58a00;
}

.html-card .card-number {
	color: #a83f31;
}

.css-card .card-number {
	color: #216886;
}

.javascript-card .card-number {
	color: #856700;
}

.card-number {
	color: var(--accent-dark);
	font-family: Arial, sans-serif;
	font-size: 0.8rem;
	font-weight: bold;
}

.split-section {
	gap: 60px;
}

.split-section > div {
	flex: 1;
}

.section-image {
	width: 42%;
	max-height: 280px;
	object-fit: cover;
}

.hobbies-list {
	display: flex;
	gap: 30px;
	margin-top: 35px;
}

.hobbies-list p {
	flex: 1;
	padding-top: 16px;
	border-top: 1px solid var(--accent);
}

.hobbies-list strong {
	color: var(--ink);
	font-size: 1.1rem;
}

.project-placeholder {
	margin-top: 30px;
	padding: 30px;
	border: 1px dashed var(--accent-dark);
	color: var(--muted);
	text-align: center;
}

.site-footer {
	padding: 25px 0;
	color: var(--white);
	background: var(--ink);
	font-family: Arial, sans-serif;
	font-size: 0.85rem;
}

.site-footer p {
	margin-bottom: 0;
}

.site-footer a {
	color: #f6ae92;
}

/* On small screens, stack the content so it stays easy to read. */
@media (max-width: 700px) {
	.navigation,
	.hero-content,
	.split-section,
	.card-row,
	.hobbies-list,
	.footer-content {
		align-items: flex-start;
		flex-direction: column;
	}

	.navigation {
		padding: 18px 0;
	}

	nav a {
		display: inline-block;
		margin: 10px 18px 0 0;
	}

	.hero {
		padding: 65px 0;
	}

	.hero-content {
		gap: 35px;
	}

	h1 {
		font-size: 3rem;
	}

	.section {
		padding: 65px 0;
	}

	.info-card,
	.section-image {
		width: 100%;
	}

	.section-image {
		max-height: 220px;
	}

	.hobbies-list {
		gap: 18px;
	}
}
